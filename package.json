{
  "name": "sudoku-training-camp",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --filter='*' dev || bunx concurrently -n server,client -c blue,green 'bun run dev:server' 'bun run dev:client'",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "bunx vite",
    "build": "bunx vite build",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:seed": "bun src/server/db/seed.ts",
    "test": "bun test"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "elysia": "^1.2.25",
    "framer-motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
